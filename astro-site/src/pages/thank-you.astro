---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { CONTACT_EMAIL } from "../config/site";
---
<Base
  title="Thank You for Applying | Vibe Connect Virtual"
  description="Your application to Vibe Connect Virtual Services has been received. Next step: watch your orientation."
  path="/thank-you"
  noindex
>
  <Navbar />
  <main class="mt-[72px] bg-sky-light px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-3xl space-y-12">
      <section class="border-t-4 border-orange bg-white px-6 py-10 text-center shadow-sm sm:px-12 sm:py-14">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-orange/15 text-orange">
          <Icon name="check" class="text-4xl" strokeWidth={2} />
        </div>
        <h1 class="mx-auto mt-6 max-w-xl text-balance font-heading text-3xl font-extrabold leading-tight text-navy sm:text-4xl">
          Thank you for applying to Vibe Connect Virtual!
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-pretty text-lg leading-relaxed text-charcoal/85">
          Your application has been received and is now under review.
        </p>

        <div class="mx-auto mt-8 flex max-w-xl items-start gap-4 border border-sky bg-sky-light p-5 text-left">
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center bg-orange text-white"><Icon name="mail" class="text-xl" strokeWidth={2} /></span>
          <p class="text-base leading-relaxed text-muted">
            Please check your inbox at <strong class="font-semibold text-navy [overflow-wrap:anywhere]" id="applicant-email">your email</strong> for your next steps
            checklist and be sure to check your <strong class="font-semibold text-navy">Spam or Junk folder</strong>, just in case it lands there.
          </p>
        </div>

        <p class="mx-auto mt-8 max-w-xl text-base text-muted">We're excited about the possibility of having you on our team!</p>
      </section>

      <section class="bg-navy px-6 py-10 text-center text-white shadow-lg sm:px-12 sm:py-12" aria-labelledby="orientation-cta">
        <p class="text-sm font-bold uppercase tracking-wide text-orange">Important: do this first</p>
        <h2 id="orientation-cta" class="mx-auto mt-3 max-w-xl text-balance font-heading text-2xl font-extrabold leading-tight text-white sm:text-3xl">Watch your orientation before you do anything else</h2>
        <p class="mx-auto mt-4 max-w-xl text-pretty text-base leading-relaxed text-sky/90 sm:text-lg">Please watch the orientation video and review the orientation guide first. It explains your next steps.</p>
        <div class="mt-8">
          <a href="/orientation" class="btn-primary inline-flex w-full items-center justify-center gap-3 px-10 py-5 text-lg font-bold shadow-xl sm:w-auto">
            Go to the orientation <Icon name="arrowRight" class="text-2xl" strokeWidth={2.5} />
          </a>
        </div>
      </section>

      <p class="text-center text-sm text-muted">Questions? Email <a class="font-semibold text-[#0d627b] underline underline-offset-4" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    </div>
  </main>
  <Footer cta={false} />

  <script>
    // Show the email the applicant entered (kept only in this tab's sessionStorage).
    try {
      const email = sessionStorage.getItem("vc_applicant_email");
      const el = document.getElementById("applicant-email");
      if (email && el) el.textContent = email;
    } catch { /* storage unavailable: keep the generic text */ }
  </script>
</Base>
