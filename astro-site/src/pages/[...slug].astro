---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Inline from "../components/Inline.astro";
import ApplyButton from "../components/ApplyButton.astro";
import {
  ARISE_DEFINITION, HUB_PAGE, LAST_UPDATED_LINE, SEO_PAGES, bannerUrl, buildPageSchema,
  type SeoPageData,
} from "../data/seo-pages";
import { LEGAL_PAGES, type LegalPageData } from "../data/legal-pages";
import { HUB_URL, PAY_SOURCE } from "../config/site";

export function getStaticPaths() {
  return [
    ...SEO_PAGES.map((page) => ({ params: { slug: page.slug }, props: { kind: "seo" as const, page } })),
    ...LEGAL_PAGES.map((page) => ({ params: { slug: page.slug }, props: { kind: "legal" as const, page } })),
  ];
}

const banners = import.meta.glob<{ default: ImageMetadata }>("../assets/banners/*.webp", { eager: true });
const { kind, page } = Astro.props as
  | { kind: "seo"; page: SeoPageData }
  | { kind: "legal"; page: LegalPageData };
const seo = kind === "seo" ? (page as SeoPageData) : null;
const legal = kind === "legal" ? (page as LegalPageData) : null;
const banner = seo ? banners[`../assets/banners/${seo.banner.file}`]?.default : undefined;
---
<Base
  title={page.title}
  description={page.description}
  path={page.path}
  ogImage={seo ? bannerUrl(seo) : undefined}
  jsonLd={seo ? buildPageSchema(seo) : undefined}
>
  <Navbar />
  <main class="mt-[72px]">
    {seo && (
      <>
        <nav aria-label="Breadcrumb" class="border-b border-sky bg-sky-light">
          <ol class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-2 px-4 py-2.5 text-xs text-muted sm:px-6">
            <li><a href="/" class="py-1 hover:text-orange">Home</a></li>
            <li aria-hidden="true">/</li>
            <li>
              {seo.isHub
                ? <span aria-current="page">{HUB_PAGE.crumb}</span>
                : <a href={HUB_URL} class="py-1 hover:text-orange">{HUB_PAGE.crumb}</a>}
            </li>
            {!seo.isHub && (<><li aria-hidden="true">/</li><li aria-current="page">{seo.crumb}</li></>)}
          </ol>
        </nav>

        <article>
          {banner && (
            <Image
              src={banner}
              alt={seo.banner.alt}
              widths={[480, 800, 1200, 1600]}
              sizes="100vw"
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-52 w-full object-cover sm:h-auto sm:max-h-[420px]"
            />
          )}

          <div class="mx-auto max-w-3xl space-y-5 px-4 py-8 sm:px-6 sm:py-10">
            <h1 class="font-heading text-[28px] font-extrabold leading-tight text-navy sm:text-4xl">{seo.h1}</h1>

            <aside aria-label="Quick answer" class="space-y-2 border-l-4 border-orange bg-sky-light p-5">
              <p class="text-xs font-bold uppercase tracking-wide text-orange">Quick answer</p>
              <p class="text-base leading-relaxed text-navy">{seo.quickAnswer}</p>
              <p class="text-sm text-muted">{ARISE_DEFINITION}</p>
              <p class="text-xs text-muted">{PAY_SOURCE}</p>
            </aside>

            <p class="text-sm text-muted">{LAST_UPDATED_LINE}</p>

            {seo.intro.map((t) => <p class="text-base leading-relaxed text-charcoal/85"><Inline text={t} /></p>)}

            {seo.sections.map((s) => (
              <>
                <section class="space-y-4 pt-4">
                  <h2 class="font-heading text-2xl font-bold text-navy">{s.h2}</h2>
                  {s.blocks.map((b) =>
                    b.type === "p" ? <p class="text-base leading-relaxed text-charcoal/85"><Inline text={b.text} /></p>
                    : b.type === "ul" ? <ul class="list-disc space-y-2 pl-6 text-base leading-relaxed text-charcoal/85">{b.items.map((it) => <li><Inline text={it} /></li>)}</ul>
                    : b.type === "ol" ? <ol class="list-decimal space-y-2 pl-6 text-base leading-relaxed text-charcoal/85">{b.items.map((it) => <li><Inline text={it} /></li>)}</ol>
                    : <p class="text-xs text-muted">{b.text}</p>
                  )}
                </section>
                {seo.midCta.afterSection === s.h2 && (
                  <aside aria-label="Apply" class="reveal my-6 space-y-3 bg-navy p-6 text-center text-white sm:p-8">
                    <p class="font-heading text-2xl font-extrabold text-white">{seo.midCta.heading}</p>
                    <p class="text-base text-sky/90">{seo.midCta.subline}</p>
                    <div class="pt-2"><ApplyButton /></div>
                  </aside>
                )}
              </>
            ))}

            <section class="space-y-5 pt-6">
              <h2 class="font-heading text-2xl font-bold text-navy">Frequently asked questions</h2>
              {seo.faq.map((f) => (
                <div class="space-y-1">
                  <h3 class="font-heading text-lg font-bold text-navy">{f.q}</h3>
                  <p class="text-base leading-relaxed text-charcoal/85"><Inline text={f.a} /></p>
                </div>
              ))}
            </section>

            {!seo.isHub && (
              <p class="pt-4 text-base">
                <a href={HUB_URL} class="font-semibold text-[#0d627b] underline underline-offset-4 hover:text-orange">See all remote work from home jobs in the US</a>
              </p>
            )}

            <section class="reveal space-y-3 bg-sky-light p-6 pt-6 text-center sm:p-8">
              <h2 class="font-heading text-2xl font-bold text-navy">{seo.finalCta.heading}</h2>
              <p class="text-base leading-relaxed text-charcoal/85"><Inline text={seo.finalCta.text} /></p>
              <div class="pt-2"><ApplyButton /></div>
            </section>
          </div>
        </article>
      </>
    )}

    {legal && (
      <article class="mx-auto max-w-3xl space-y-5 px-4 py-10 sm:px-6 sm:py-12">
        <h1 class="font-heading text-3xl font-extrabold text-navy sm:text-4xl">{legal.h1}</h1>
        <p class="text-sm text-muted">Last updated: {legal.updated}</p>
        {legal.sections.map((s) => (
          <section class="space-y-3 pt-2">
            <h2 class="font-heading text-xl font-bold text-navy">{s.h2}</h2>
            {s.paragraphs?.map((t) => <p class="text-base leading-relaxed text-charcoal/85">{t}</p>)}
            {s.items && <ul class="list-disc space-y-2 pl-6 text-base leading-relaxed text-charcoal/85">{s.items.map((t) => <li>{t}</li>)}</ul>}
          </section>
        ))}
      </article>
    )}
  </main>
  <Footer cta={false} />
</Base>
