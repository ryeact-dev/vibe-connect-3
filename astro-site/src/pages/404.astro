---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { HUB_URL } from "../config/site";
---
<Base title="Page Not Found | Vibe Connect Virtual" description="The page you're looking for doesn't exist. Return to Vibe Connect Virtual to find remote work from home jobs." path="/404" noindex>
  <Navbar />
  <main class="mt-[72px] flex min-h-[60vh] items-center justify-center px-4 py-16 text-center">
    <div class="space-y-4">
      <p class="font-heading text-6xl font-extrabold text-orange">404</p>
      <h1 class="font-heading text-2xl font-bold text-navy">Page not found</h1>
      <p class="text-muted">That page doesn't exist or has moved.</p>
      <p class="space-x-4 pt-2">
        <a class="font-semibold text-[#0d627b] underline underline-offset-4" href="/">Return home</a>
        <a class="font-semibold text-[#0d627b] underline underline-offset-4" href={HUB_URL}>Remote work from home jobs</a>
      </p>
    </div>
  </main>
  <Footer cta={false} />
</Base>
