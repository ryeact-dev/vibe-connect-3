---
import Icon from "./Icon.astro";
import { APPLY_URL } from "../config/site";
import { ABOUT_PARAGRAPH, ABOUT_STATES, ABOUT_STATES_LABEL } from "../data/home-copy";
import { ABOUT_IMAGE, AGENT_IMAGE } from "../data/images";
---
<section id="about" class="bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="reveal space-y-5 text-left lg:col-span-6">
        <h2 class="font-heading text-3xl font-extrabold leading-tight text-navy sm:text-4xl lg:leading-[1.3]">
          We Are The Best Remote Career Service For Your People
        </h2>
        <p class="text-base leading-relaxed text-muted">{ABOUT_PARAGRAPH}</p>
        <p class="text-sm leading-relaxed text-muted"><strong class="font-semibold text-navy">{ABOUT_STATES_LABEL}</strong> {ABOUT_STATES}.</p>

        <div class="grid grid-cols-1 gap-x-6 gap-y-6 pt-2 sm:grid-cols-2">
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-orange font-heading text-xs font-bold text-orange">24h</div>
            <div>
              <h3 class="mb-1 font-heading text-base font-bold text-orange">24/7 Customer Support</h3>
              <p class="text-sm leading-relaxed text-muted">Round-the-clock assistance whenever you need it day or night, our team is always available to help.</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-orange text-orange"><Icon name="phoneCall" class="text-xl" /></div>
            <div>
              <h3 class="mb-1 font-heading text-base font-bold text-orange">Always Reach</h3>
              <p class="text-sm leading-relaxed text-muted">Stay connected with us anytime through a direct call, we're just a phone call away.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 sm:col-span-2 sm:max-w-sm">
            <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-orange text-orange"><Icon name="headphones" class="text-xl" /></div>
            <div>
              <h3 class="mb-1 font-heading text-base font-bold text-orange">Chat Support</h3>
              <p class="text-sm leading-relaxed text-muted">Get quick answers and real-time help through our live chat feature.</p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a href={APPLY_URL} data-apply class="btn-primary inline-flex items-center gap-2 px-7 py-3.5 text-sm font-bold">
            Start Your Remote Journey <Icon name="arrowRight" class="text-base" />
          </a>
        </div>
      </div>

      <div class="reveal lg:col-span-6" style="--d:80ms">
        <div class="relative aspect-[4/3] overflow-hidden shadow-2xl">
          <img src={ABOUT_IMAGE} alt="Two remote agents working together at a workstation with headsets" width="1200" height="900" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="w-full overflow-hidden bg-navy text-white" aria-labelledby="agent-heading">
  <div class="grid w-full grid-cols-1 lg:min-h-[600px] lg:grid-cols-2">
    <div class="relative h-64 min-h-[260px] overflow-hidden sm:h-96 lg:h-full">
      <img src={AGENT_IMAGE} alt="Agent celebrating at a desk while wearing a headset" width="1000" height="800" class="absolute inset-0 h-full w-full object-cover object-center" loading="lazy" decoding="async" />
    </div>
    <div class="reveal flex flex-col justify-center bg-navy px-6 py-12 text-left sm:px-10 md:px-16 xl:px-20">
      <h2 id="agent-heading" class="mb-5 font-heading text-3xl font-extrabold leading-[1.25] text-white sm:text-4xl lg:text-[44px]">
        We're Built Around the Agent, Not Just the Client
      </h2>
      <p class="mb-8 max-w-xl text-base leading-relaxed text-sky/90">
        Most staffing companies optimize for the business paying the bill. We optimize for the person doing the work because agents who feel supported stay longer, perform better, and actually enjoy the job.
      </p>
      <div class="mb-10 grid max-w-xl grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8">
        <div class="flex items-start gap-3.5">
          <Icon name="headphones" class="mt-0.5 text-[32px] text-orange" strokeWidth={2} />
          <div>
            <h3 class="mb-1.5 font-heading text-lg font-bold text-orange">Real Support, Real Fast</h3>
            <p class="text-sm leading-relaxed text-sky/80">Get quick answers and real-time help through our live chat feature.</p>
          </div>
        </div>
        <div class="flex items-start gap-3.5">
          <Icon name="shield" class="mt-0.5 text-[32px] text-orange" strokeWidth={2} />
          <div>
            <h3 class="mb-1.5 font-heading text-lg font-bold text-orange">Straightforward Pay &amp; Shifts</h3>
            <p class="text-sm leading-relaxed text-sky/80">You'll know your pay rate, schedule, and role expectations before you ever say yes.</p>
          </div>
        </div>
      </div>
      <div>
        <a href={APPLY_URL} data-apply class="btn-primary inline-flex w-full items-center justify-center gap-2.5 px-10 py-4 text-base font-bold shadow-lg sm:w-auto">
          <span>Apply Now!</span><Icon name="arrowRight" class="text-xl" strokeWidth={2.5} />
        </a>
      </div>
    </div>
  </div>
</section>
