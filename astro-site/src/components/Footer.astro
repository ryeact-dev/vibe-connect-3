---
import Icon from "./Icon.astro";
import { APPLY_URL, CONTACT_EMAIL, CONTACT_PHONE_TEL, HUB_URL } from "../config/site";
import { FINAL_CTA_BODY } from "../data/home-copy";
import { ROLE_PAGES } from "../data/seo-pages";
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
{cta && (
  <section class="relative overflow-hidden bg-navy py-16 text-white sm:py-20">
    <div class="reveal relative z-10 mx-auto max-w-5xl space-y-6 px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">Ready to Trade the Commute for a Headset and a Kitchen Table?</h2>
      <p class="mx-auto max-w-2xl text-base leading-relaxed text-sky/90 sm:text-lg">{FINAL_CTA_BODY}</p>
      <div class="pt-2">
        <a href={APPLY_URL} data-apply class="btn-primary inline-flex w-full items-center justify-center gap-2.5 px-9 py-4 text-base font-bold shadow-xl sm:w-auto">
          Apply Now <Icon name="arrowRight" class="text-xl" />
        </a>
      </div>
    </div>
  </section>
)}

<footer id="contact" class="border-t border-white/10 bg-navy-dark pb-10 pt-14 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="footer-grid">
      <div class="area-contact space-y-5 border border-white/10 bg-navy p-6 sm:p-8">
        <div class="space-y-3">
          <p class="text-xs font-bold uppercase tracking-wider text-orange">Contact Us &amp; More Details</p>
          <h2 class="font-heading text-2xl font-bold text-white">Have Questions Before You Apply?</h2>
          <p class="text-sm leading-relaxed text-sky/80">We know searching for work-from-home positions can be daunting. That's why Vibe Connect Virtual provides transparent expectations, and prompt candidate communication. Have a specific question about client contracts or onboarding support? Our recruitment desk is standing by to help.</p>
        </div>
        <div class="space-y-3 pt-1">
          <a href={`tel:${CONTACT_PHONE_TEL}`} class="flex items-center gap-3 text-sm font-semibold text-white hover:text-orange">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-orange text-white"><Icon name="phone" class="text-base" /></span>
            <span>+1.903.847.7904 &bull; Call or Text</span>
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="flex items-center gap-3 break-all text-sm font-semibold text-white hover:text-orange">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-orange text-white"><Icon name="mail" class="text-base" /></span>
            <span>{CONTACT_EMAIL}</span>
          </a>
          <a href="https://www.facebook.com/people/Vibe-Connect-Virtual-Services/61567573289685/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm font-semibold text-white hover:text-orange">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-orange text-white"><Icon name="facebook" class="text-base" /></span>
            <span>Follow us on Facebook</span>
          </a>
        </div>
      </div>

      <nav aria-labelledby="footer-links-title" class="area-links">
        <h3 id="footer-links-title" class="font-heading text-xl font-bold text-white">Quick links</h3>
        <ul class="mt-4 space-y-1 border-l-2 border-orange/60 pl-4 text-sm font-semibold text-sky">
          {ROLE_PAGES.map((r) => <li><a href={r.path} class="block py-1.5 hover:text-orange">{r.crumb}</a></li>)}
          <li><a href="/orientation" class="block py-1.5 hover:text-orange">Orientation</a></li>
        </ul>
      </nav>

      <div class="area-bottom flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-sky/60 sm:flex-row">
        <p>&copy; {year} Vibe Connect Virtual LLC. All rights reserved. Equal Opportunity Remote Staffing Partner. Agents are independent contractors (1099), not employees.</p>
        <div class="flex items-center gap-6">
          <a href="/privacy-policy" class="py-1 hover:text-white">Privacy Policy</a>
          <a href="/terms" class="py-1 hover:text-white">Terms of Service</a>
        </div>
      </div>

      <p class="area-credit text-center text-xs text-sky/60 md:text-left">Website by <a href="https://www.rmdigitalsolutionsph.com/" class="underline hover:text-white">RM Digital Solutions</a></p>
    </div>
  </div>
</footer>

<style>
  /* One grid, two layouts: stacked on phones, two columns from md up. */
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    grid-template-areas: "contact" "links" "bottom" "credit";
  }
  .area-contact { grid-area: contact; }
    .area-links { grid-area: links; }
  .area-bottom { grid-area: bottom; }
  .area-credit { grid-area: credit; }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 3rem;
      row-gap: 1.5rem;
      grid-template-areas: "contact links" "bottom bottom" "credit credit";
    }
    .area-contact { align-self: start; }
    .area-bottom { margin-top: 1.5rem; }
  }
</style>
