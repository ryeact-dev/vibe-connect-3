---
import Icon from "./Icon.astro";
interface Props {
  items: { question: string; answer: string }[];
  heading?: string;
  intro?: string;
  /** Inside an article (SEO pages): no section background, left-aligned H2, no #faq id. */
  embedded?: boolean;
}
const { items, heading = "Frequently Asked Questions", intro, embedded = false } = Astro.props;
---
<Fragment>
  {embedded ? (
    <section class="space-y-4 pt-6">
      <h2 class="font-heading text-2xl font-bold text-navy">{heading}</h2>
      <div class="space-y-3">
        {items.map((f, i) => (
          <details class="faq overflow-hidden border border-[#e67320]/30 bg-white" open={i === 0}>
            <summary class="flex min-h-[48px] items-center justify-between gap-4 bg-[#f38c32] px-5 py-4 text-left text-white transition-colors duration-150 hover:bg-[#e67b25]">
              <h3 class="flex-1 font-heading text-sm font-bold sm:text-base">{f.question}</h3>
              <Icon name="plus" class="faq-icon text-xl" />
            </summary>
            <div class="faq-body border-t border-gray-100 px-5 pb-6 pt-4 text-base leading-relaxed text-charcoal/80 sm:px-6">{f.answer}</div>
          </details>
        ))}
      </div>
    </section>
  ) : (
    <section id="faq" class="bg-sky/40 py-14 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal mb-10 space-y-4 text-center">
          <h2 class="font-heading text-3xl font-extrabold text-navy sm:text-4xl">{heading}</h2>
          {intro && <p class="mx-auto max-w-2xl text-base text-muted">{intro}</p>}
        </div>
        <div class="mx-auto max-w-3xl space-y-3">
          {items.map((f, i) => (
            <details class="faq overflow-hidden border border-[#e67320]/30 bg-white" open={i === 0}>
              <summary class="flex min-h-[48px] items-center justify-between gap-4 bg-[#f38c32] px-5 py-4 text-left text-white transition-colors duration-150 hover:bg-[#e67b25]">
                <h3 class="flex-1 font-heading text-sm font-bold sm:text-base">{f.question}</h3>
                <Icon name="plus" class="faq-icon text-xl" />
              </summary>
              <div class="faq-body border-t border-gray-100 px-5 pb-6 pt-4 text-sm leading-relaxed text-charcoal/80 sm:px-6 sm:text-base">{f.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Fragment>

<script>
  // Exclusive accordion with smooth open/close (Web Animations API). Opening an item
  // closes the one that was open. Reduced-motion users get the same behaviour, instantly.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DURATION = 380;
  const EASE = "cubic-bezier(0.22, 1, 0.36, 1)";
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.faq"));
  const running = new WeakMap<HTMLDetailsElement, Animation[]>();

  function stop(d: HTMLDetailsElement) {
    running.get(d)?.forEach((a) => a.cancel());
    running.delete(d);
  }

  function toggle(d: HTMLDetailsElement, opening: boolean) {
    const summary = d.querySelector("summary") as HTMLElement;
    const body = d.querySelector(".faq-body") as HTMLElement;
    stop(d);
    if (reduce || !("animate" in d)) { d.open = opening; return; }

    const closedH = summary.offsetHeight;
    if (opening) d.open = true;
    const fullH = d.offsetHeight;
    d.style.overflow = "hidden";

    const box = d.animate(
      { height: opening ? [`${closedH}px`, `${fullH}px`] : [`${fullH}px`, `${closedH}px`] },
      { duration: DURATION, easing: EASE },
    );
    const text = body.animate(
      opening ? { opacity: [0, 1], transform: ["translateY(-6px)", "none"] } : { opacity: [1, 0] },
      { duration: DURATION * (opening ? 0.9 : 0.5), easing: "ease-out", delay: opening ? DURATION * 0.1 : 0 },
    );
    running.set(d, [box, text]);
    box.onfinish = () => { d.open = opening; d.style.overflow = ""; running.delete(d); };
    box.oncancel = () => { d.style.overflow = ""; };
  }

  // dataset.state is the *target* state, so rapid clicks mid-animation behave sensibly.
  items.forEach((d) => (d.dataset.state = d.open ? "open" : "closed"));

  items.forEach((d) => {
    d.querySelector("summary")!.addEventListener("click", (e) => {
      e.preventDefault();
      const opening = d.dataset.state !== "open";
      d.dataset.state = opening ? "open" : "closed";
      if (opening) {
        // one at a time: close every other item that is open (or opening)
        items.forEach((o) => {
          if (o !== d && o.dataset.state === "open") { o.dataset.state = "closed"; toggle(o, false); }
        });
      }
      toggle(d, opening);
    });
  });
</script>
