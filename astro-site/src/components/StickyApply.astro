---
import Icon from "./Icon.astro";
import { APPLY_URL } from "../config/site";
---
<!-- Phones only: an Apply Now bar pinned to the bottom of the screen. -->
<div class="fixed inset-x-0 bottom-0 z-30 border-t border-gray-200 bg-white/95 px-4 pt-3 shadow-[0_-4px_16px_rgba(27,42,74,0.12)] backdrop-blur md:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
  <a href={APPLY_URL} data-apply class="btn-primary flex w-full items-center justify-center gap-2.5 px-6 py-3.5 text-base font-bold">
    <span>Apply Now</span><Icon name="arrowRight" class="text-xl" strokeWidth={2.5} />
  </a>
</div>
