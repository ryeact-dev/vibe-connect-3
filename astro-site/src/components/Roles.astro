---
import Icon from "./Icon.astro";
import { ROLES_DATA } from "../data/roles-data";
import { HUB_LINK_TEXT, ROLES_INTRO } from "../data/home-copy";
import { HUB_URL } from "../config/site";
const icons = ["headphones", "phoneCall", "userCheck", "headphones"] as const;
---
<section id="roles" class="bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto mb-12 max-w-3xl space-y-4 text-center">
      <h2 class="font-heading text-3xl font-extrabold leading-[1.3] text-navy sm:text-4xl">Find the Role That Fits You</h2>
      <p class="text-base text-muted">{ROLES_INTRO}</p>
      <p class="text-base font-semibold">
        <a href={HUB_URL} class="text-[#0d627b] underline underline-offset-4 hover:text-orange">{HUB_LINK_TEXT}</a>
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {ROLES_DATA.map((r, i) => (
        <li class="reveal group flex flex-col items-center border border-sky bg-white p-6 text-center transition-[box-shadow,border-color,translate] duration-[450ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-orange/40 hover:shadow-lg" style={`--d:${(i % 4) * 60}ms`}>
          <div class="mb-4 flex h-14 w-14 items-center justify-center bg-sky text-[#0d627b] transition-colors duration-[400ms] ease-out group-hover:bg-orange group-hover:text-white">
            <Icon name={icons[i] ?? "headphones"} class="text-[28px]" strokeWidth={2} />
          </div>
          <h3 class="mb-2 font-heading text-lg font-bold text-navy transition-colors duration-[400ms] ease-out group-hover:text-orange">{r.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{r.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
