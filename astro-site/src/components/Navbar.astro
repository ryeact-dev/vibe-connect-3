---
import Icon from "./Icon.astro";
import { APPLY_URL, HUB_URL, ORG_LOGO_URL, SITE_LEGAL_NAME } from "../config/site";
import { SEO_PAGES } from "../data/seo-pages";

const links = [
  { name: "Home", href: "/#home", id: "home" },
  { name: "About Us", href: "/#about", id: "about" },
  { name: "Remote Jobs", href: HUB_URL, id: "jobs" },
  { name: "FAQ", href: "/#faq", id: "faq" },
  { name: "Contact Us", href: "/#contact", id: "contact" },
];
// Static builds can report "/page.html" or "/page/": normalise before comparing.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/+$/, "") || "/";
// The hub and every role page belong to the "Remote Jobs" section.
const inJobs = SEO_PAGES.some((p) => p.path === path);
const isActive = (id: string) => id === "jobs" && inJobs;
---
<div id="top-sentinel" aria-hidden="true" class="absolute top-0 left-0 h-6 w-px pointer-events-none"></div>
<header id="site-header" data-default={inJobs ? "jobs" : ""} data-sticky={path === "/" ? "1" : "0"} class="fixed top-0 inset-x-0 z-40 bg-white py-3 transition-shadow duration-200 data-[scrolled=true]:shadow-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center" aria-label={`${SITE_LEGAL_NAME} home`}>
      <img
        src={ORG_LOGO_URL}
        alt={SITE_LEGAL_NAME}
        height="48"
        class="h-10 w-auto object-contain md:h-12"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex xl:gap-9">
      {links.map((l) => (
        <a
          href={l.href}
          data-nav={l.id}
          data-active={isActive(l.id) ? "true" : "false"}
          aria-current={l.href === path ? "page" : undefined}
          class="relative py-1 font-heading text-[17px] font-bold text-navy transition-colors duration-150 hover:text-orange data-[active=true]:text-orange after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-orange after:transition-transform after:duration-200 data-[active=true]:after:scale-x-100"
        >{l.name}</a>
      ))}
    </nav>

    <div class="hidden items-center lg:flex">
      <a href={APPLY_URL} data-apply class="btn-primary inline-flex items-center gap-2 bg-[#DF7B43] px-7 py-3 text-base font-bold tracking-wide">
        <span>Apply Now!</span><Icon name="arrowRight" class="text-base" strokeWidth={2.5} />
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-navy hover:text-orange lg:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="text-[28px] icon-open" />
      <Icon name="x" class="hidden text-[28px] icon-close" />
    </button>
  </div>

  <div id="mobile-menu" hidden class="max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-gray-200 bg-white px-4 pb-6 pt-3 shadow-xl lg:hidden">
    <nav aria-label="Mobile" class="space-y-1">
      {links.map((l) => (
        <a href={l.href} aria-current={l.href === path ? "page" : undefined} class:list={["block px-3 py-3 font-heading text-base font-bold hover:bg-gray-50 hover:text-orange", isActive(l.id) ? "border-l-4 border-orange bg-sky-light text-orange" : "text-navy"]}>{l.name}</a>
      ))}
    </nav>
    <div class="pt-3">
      <a href={APPLY_URL} data-apply class="btn-primary flex w-full items-center justify-center gap-2 bg-[#DF7B43] py-3.5 text-center font-heading text-base font-bold">
        <span>Apply Now!</span><Icon name="arrowRight" class="text-base" strokeWidth={2.5} />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  // Header shadow: one observer on a sentinel instead of a scroll handler.
  const sentinel = document.getElementById("top-sentinel");
  if (sentinel && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => header.setAttribute("data-scrolled", String(!e.isIntersecting))).observe(sentinel);
  }

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector(".icon-open")!.classList.toggle("hidden", open);
    toggle.querySelector(".icon-close")!.classList.toggle("hidden", !open);
  };
  toggle.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")));
  menu.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) setOpen(false); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu.hasAttribute("hidden")) { setOpen(false); toggle.focus(); } });
  matchMedia("(min-width: 1024px)").addEventListener("change", (m) => { if (m.matches) setOpen(false); });

  // Scroll-spy. Sections that exist on the page (home sections, or just the footer's #contact)
  // highlight their nav link while mostly in view. When none is in view, the nav returns to the
  // page's own link ("Remote Jobs" on the hub/role pages); on the homepage the last one stays.
  const ids = ["home", "about", "faq", "contact"];
  const targets = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const fallback = header.dataset.default || "";
  const sticky = header.dataset.sticky === "1";
  if (targets.length && "IntersectionObserver" in window) {
    const inView = new Set<string>();
    let current = fallback;
    const paint = (id: string) => {
      current = id;
      document.querySelectorAll<HTMLElement>("[data-nav]").forEach((a) =>
        a.setAttribute("data-active", String(a.dataset.nav === id)));
    };
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.intersectionRatio >= 0.3 || (e.isIntersecting && e.intersectionRatio > 0 && e.boundingClientRect.height > innerHeight && e.intersectionRect.height >= innerHeight * 0.3)) inView.add(e.target.id);
        else inView.delete(e.target.id);
      }
      const active = [...targets].reverse().find((t) => inView.has(t.id));
      if (active) paint(active.id);
      else if (fallback || !sticky) paint(fallback);
    }, { threshold: [0, 0.3, 0.6, 1] });
    targets.forEach((t) => spy.observe(t));
  }
</script>
